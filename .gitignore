# ============================================================
# CampusOverflow AI 根 .gitignore（兜底层）
# frontend / agent / backend 各有自己的 .gitignore，此处统一兜底。
# 原则：源码与锁文件（uv.lock / package-lock.json）入库，
#       虚拟环境、依赖、构建产物、密钥、日志一律不入库。
# ============================================================

# ---------- OS ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- IDE ----------
.idea/
.vscode/
*.swp
*.swo

# ---------- 环境变量与密钥（仅放行 .env.example / .env.*.example 模板） ----------
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key

# ---------- Node / Next.js（frontend、agent 兜底） ----------
node_modules/
.next/
out/
build/
dist/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache
.vitest-cache/
.vite/
coverage/
.nyc_output/
test-results/
playwright-report/
blob-report/

# ---------- Python / uv（backend 兜底） ----------
# 虚拟环境：绝不入库（uv venv 生成于 backend/.venv）
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
# import-linter（lint-imports）与 grimp 的分析缓存（自带内部 .gitignore，此处显式声明）
.grimp_cache/
.import_linter_cache/
.coverage
.coverage.*
htmlcov/

# ---------- 本地数据库及运行时旁文件 ----------
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.sqlite3
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm

# ---------- 一次性临时产物 ----------
# 本地文档、规格、规则、个人笔记与归档只留本地，不随仓库发布
# 注意：已跟踪文件仍需 git rm --cached 才会从远端移除
/.trae/
/docs/
/specs/
/my_engineer_docs/
/.workbuddy/
/_archive/
# Cross_testing 生成结果（报告与 CSV）
/Cross_testing/results/
.tmp/
*.tmp

# ---------- 日志 ----------
*.log
logs/

# ---------- 本地手动备份目录（如迁移时的整目录副本），永不入库 ----------
campus-overflow-ai/frontend copy/
**/* copy/

# ---------- 说明 ----------
# - uv.lock / package-lock.json 是锁文件，必须提交，勿加入忽略
# - alembic/versions/ 迁移脚本必须提交，勿忽略
campus-overflow-ai/frontend/前端-后端调用图谱.md
.mimosa/
# 独立WF-04数据库/进程验收产物，不进入版本库
campus-overflow-ai/.wf04-*/
