# ============================================================
# CampusOverflow AI 根 .gitignore（兜底层）
# frontend / agent / backend 各有自己的 .gitignore，此处统一兜底。
# 原则：源码与锁文件（uv.lock / package-lock.json）入库，
#       虚拟环境、依赖、构建产物、密钥、日志一律不入库。
# ============================================================

# ---------- OS ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- IDE ----------
.idea/
.vscode/
*.swp
*.swo

# ---------- 环境变量与密钥（只允许 .env.example 入库） ----------
.env
.env.local
.env.*.local
*.pem
*.key

# ---------- Node / Next.js（frontend、agent 兜底） ----------
node_modules/
.next/
out/
build/
dist/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache
.vitest-cache/
coverage/

# ---------- Python / uv（backend 兜底） ----------
# 虚拟环境：绝不入库（uv venv 生成于 backend/.venv）
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# ---------- 日志 ----------
*.log
logs/

# ---------- 本地手动备份目录（如迁移时的整目录副本），永不入库 ----------
campus-overflow-ai/frontend copy/
**/* copy/

# ---------- 说明 ----------
# - uv.lock / package-lock.json 是锁文件，必须提交，勿加入忽略
# - .workbuddy/memory/ 是项目工作日志，保持入库
# - alembic/versions/ 迁移脚本必须提交，勿忽略
