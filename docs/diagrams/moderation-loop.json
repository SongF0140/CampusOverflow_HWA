{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "内容治理闭环：AI 预警 + 人工处置",
    "locale": "zh-CN",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "detect",
        "label": "发布与静默检测",
        "focus": ["publish", "save", "scan", "low", "case"],
        "note": "内容先保存展示，AI 随后静默扫描并按风险分级。"
      },
      {
        "id": "handle",
        "label": "人工处置",
        "focus": ["case", "queue", "resolve", "notify", "close"],
        "note": "中高风险只生成工单，七种处置动作全部由管理员人工执行。"
      },
      {
        "id": "appeal",
        "label": "申诉复核",
        "focus": ["notify", "appeal", "close"],
        "note": "当事人可申诉，复核结论通知本人并全程留痕。"
      }
    ]
  },
  "lanes": [
    { "id": "author", "label": "学生与内容" },
    { "id": "core", "label": "业务后端 FastAPI" },
