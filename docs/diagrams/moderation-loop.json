    { "id": "queue-resolve", "from": "queue", "to": "resolve", "label": "人工确认", "variant": "emphasis", "role": "main" },
    { "id": "resolve-notify", "from": "resolve", "to": "notify", "label": "执行结果", "variant": "emphasis", "role": "main" },
    { "id": "notify-close", "from": "notify", "to": "close", "label": "结论留痕", "variant": "emphasis", "role": "main" },
    { "id": "notify-appeal", "from": "notify", "to": "appeal", "label": "可申诉", "variant": "dashed", "role": "branch" }
