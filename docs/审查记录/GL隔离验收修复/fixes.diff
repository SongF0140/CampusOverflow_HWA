+"""moderation_cases.updated_at 补充默认值（模型与迁移漂移修正）。
+
+真实 MySQL 上发现：模型声明 nullable=False + server_default，但 t16_add_agent_decision
+以 nullable=True 且无默认值添加该列，导致新建治理工单写入 NULL、建单接口 500。
+SQLite 用模型建表看不出来，只有跑迁移后的真实库才暴露。
+"""
+
+from alembic import op
+import sqlalchemy as sa
+
+revision = "fix_updated_at_default"
+down_revision = "gl04_job_resume"
+branch_labels = None
+depends_on = None
+
+
+def upgrade() -> None:
+    # 先回填历史 NULL，避免加 NOT NULL 时报错
+    op.execute("UPDATE moderation_cases SET updated_at = created_at WHERE updated_at IS NULL")
+    op.alter_column(
+        "moderation_cases",
+        "updated_at",
+        existing_type=sa.DateTime(),
+        nullable=False,
+        server_default=sa.func.now(),
+    )
+
+
+def downgrade() -> None:
+    op.alter_column(
+        "moderation_cases",
+        "updated_at",
+        existing_type=sa.DateTime(),
+        nullable=True,
+        server_default=None,
+    )
