# ============================================================
# CampusOverflow AI 生产环境变量模板（T-18 交付物）
# 用法：cp deploy/.env.example deploy/.env  然后逐项改成真实值
# docker compose 从 compose 文件所在目录（deploy/）读取 .env
# 规则：真实部署必须覆盖全部 change-me 项；三处 token 必须一致。
# ============================================================

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=change-me-strong-password
MYSQL_DATABASE=campus_overflow

# ---------- 业务后端（前缀 BACKEND_，见 backend/app/core/config.py）----------
BACKEND_JWT_SECRET=change-me-jwt-secret
# 服务间凭证：后端校验 Agent 的 X-Service-Token，Agent 侧用同一个值（强制一致）
BACKEND_AGENT_SERVICE_TOKEN=change-me-service-token
# 公网来源（同源 BFF 下浏览器只访问前端，此处兜底 CORS 白名单）
BACKEND_CORS_ORIGINS=http://CHANGE-ME-SERVER-IP-OR-DOMAIN
BACKEND_PORT=8000

# ---------- 入口与前端 ----------
HTTP_PORT=80
FRONTEND_PORT=3000

# ---------- Agent（本次 release 已停用 AI 端点，可全部留空）----------
OPENAI_API_KEY=
OPENAI_BASE_URL=
AGENT_MODEL_ID=gpt-4o-mini
