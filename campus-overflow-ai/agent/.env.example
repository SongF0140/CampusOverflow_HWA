# 在Agent服务器本地配置，不把实际密钥写入仓库。
# 三种角色共用公共工具实现，主规则和任务白名单可进一步收窄权限。
WEB_SEARCH_ENABLED=false
TAVILY_API_KEY=
WEB_BROWSER_ENABLED=false

# 教材 RAG：默认关闭；开启后需配置本地知识目录与 Qwen/GLM 的 OpenAI 兼容 embedding
KNOWLEDGE_ROOT=
RAG_ENABLED=false
RAG_EMBEDDING_BASE_URL=
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_MODEL=
# 可选：批量、超时与维度校验
RAG_EMBEDDING_BATCH_SIZE=32
RAG_EMBEDDING_TIMEOUT_MS=30000
RAG_EMBEDDING_DIMENSIONS=
