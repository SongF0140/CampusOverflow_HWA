{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "rootDir": ".",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "plugins": [{ "name": "workflow" }]
  },
  "include": ["src", "plugins", "middleware", "nitro.config.ts"],
  "exclude": ["node_modules", "dist", "tests", ".output", ".nitro"]
}
